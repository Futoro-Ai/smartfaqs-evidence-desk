# The public synthetic demo requires no secrets.
# Optional comma-separated origins allowed to call the remote MCP endpoint.
MCP_ALLOWED_ORIGINS=http://localhost:3000

# Optional claim assessment: backend only, default-off. Restart after changes.
# Enable only for an authorized, budgeted local/private pilot, never with a
# NEXT_PUBLIC_ key. Public rollout also needs shared authorization/cost controls.
JEV_CLAIM_ASSESSMENT_ENABLED=false
JEV_API_KEY=
JEV_ASSESSMENT_MAX_INPUT_TOKENS=64000
JEV_ASSESSMENT_PROCESS_INPUT_TOKENS=256000
